const gtagSet = require('gtagSet');
const setDefaultConsentState = require('setDefaultConsentState');
const updateConsentState = require('updateConsentState');
const callInWindow = require('callInWindow');
const getCookieValues = require('getCookieValues');
const getType = require('getType');
const makeNumber = require('makeNumber');
const JSON = require('JSON');
const gTagConsents = ['ad_storage', 'analytics_storage', 'personalization_storage', 'functionality_storage', 'security_storage', 'ad_user_data', 'ad_personalization'];
const betasiConsentCookie = 'BetasiConsent';

// Set advanced settings
gtagSet({
  url_passthrough: data.url_passthrough || false,
  ads_data_redaction: data.ads_data_redaction || false
});

// The partitioned and the unpartitioned BetasiConsent cookie can both exist, so take the first valid one
const cookieCategories = () => {
    const values = getCookieValues(betasiConsentCookie) || [];
    for (let i = 0; i < values.length; i++) {
        const cookie = JSON.parse(values[i]);
        if (getType(cookie) === 'object' && getType(cookie.categories) === 'array') {
            return cookie.categories;
        }
    }
    return undefined;
};

const cookieSettings = (categories) => {
    const settings = {};
    gTagConsents.forEach((type) => {
        settings[type] = type === 'functionality_storage' || categories.indexOf(type) !== -1 ? 'granted' : 'denied';
    });
    return settings;
};

const fieldSettings = () => {
    const settings = {};
    gTagConsents.forEach((type) => {
        const value = getType(data[type]) === 'string' ? data[type] : 'denied';
        if (value !== 'notset') {
            settings[type] = value;
        }
    });
    settings.wait_for_update = makeNumber(data.wait_for_update);
    return settings;
};

const categories = cookieCategories();
setDefaultConsentState(categories === undefined ? fieldSettings() : cookieSettings(categories));

// PremiumStay calls the listener before it pushes client-consent-update, so tags on that event see the new state
const onUserConsent = (state) => {
    if (getType(state) !== 'object') {
        return;
    }
    const settings = {};
    gTagConsents.forEach((type) => {
        if (state[type] === 'granted' || state[type] === 'denied') {
            settings[type] = state[type];
        }
    });
    updateConsentState(settings);
};

callInWindow('addBetasiConsentListener', onUserConsent);

// Call data.gtmOnSuccess when the tag is finished.
data.gtmOnSuccess();


