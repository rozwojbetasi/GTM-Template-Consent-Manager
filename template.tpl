___TESTS___

scenarios:
- name: default without cookie uses the field values and waits for an update
  code: |-
    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500
    });
    assertApi('gtmOnSuccess').wasCalled();
- name: default takes the state from the cookie without waiting
  code: |-
    cookies = ['{"categories":["functionality_storage","ad_storage"]}'];

    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith(grantedAds);
    assertApi('gtmOnSuccess').wasCalled();
- name: default skips an invalid cookie and uses the next valid one
  code: |-
    cookies = ['not json', '{"categories":["analytics_storage"]}'];

    runCode(mockData);

    assertApi('setDefaultConsentState').wasCalledWith({
      ad_storage: 'denied',
      analytics_storage: 'granted',
      personalization_storage: 'denied',
      functionality_storage: 'granted',
      security_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });
    assertApi('gtmOnSuccess').wasCalled();
- name: registers a listener that updates the consent state
  code: |-
    runCode(mockData);

    assertApi('callInWindow').wasCalled();
    assertThat(listener).isFunction();
    assertApi('updateConsentState').wasNotCalled();

    listener(grantedAds);

    assertApi('updateConsentState').wasCalledWith(grantedAds);
- name: listener ignores invalid values
  code: |-
    const updates = [];
    mock('updateConsentState', (settings) => {
      updates.push(settings);
    });

    runCode(mockData);

    listener({ ad_storage: 'granted', analytics_storage: 'yes', unknown_storage: 'granted' });
    listener('granted');

    assertThat(updates).isEqualTo([{ ad_storage: 'granted' }]);
- name: extra settings sent
  code: |-
    mock('gtagSet', (obj) => {
      assertThat(obj.url_passthrough).isEqualTo(true);
      assertThat(obj.ads_data_redaction).isEqualTo(true);
    });

    runCode(mockData);

    assertApi('gtmOnSuccess').wasCalled();
setup: |-
  const mockData = {
    ad_storage: 'denied',
    analytics_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    personalization_storage: 'notset',
    functionality_storage: 'granted',
    security_storage: 'denied',
    wait_for_update: '500',
    url_passthrough: true,
    ads_data_redaction: true
  };
  const grantedAds = {
    ad_storage: 'granted',
    analytics_storage: 'denied',
    personalization_storage: 'denied',
    functionality_storage: 'granted',
    security_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied'
  };
  let cookies = [];
  let listener;

  mock('getCookieValues', (name) => name === 'BetasiConsent' ? cookies : []);
  mock('callInWindow', (name, callback) => {
    if (name === 'addBetasiConsentListener') listener = callback;
  });


